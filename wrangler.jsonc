{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cyfuel",
  "account_id": "f027194dcc0be7e3812e673468bab58d",
  // Today's date for a new Worker. Review compatibility notes before advancing it.
  "compatibility_date": "2026-10-02",
  "main": "./worker/index.ts",
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "version_metadata": {
    "binding": "CF_VERSION"
  },
  "analytics_engine_datasets": [
    {
      "binding": "AUDIT_HITS",
      "dataset": "cybush"
    }
  ],
  // Workers AI. Neurons come from the Cloudflare account. No third-party LLM key.
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  // Production hostname. Deploy attaches this custom domain on the cybush.uk zone.
  "routes": [
    {
      "pattern": "cyfuel.cybush.uk",
      "custom_domain": true
    }
  ]
}
